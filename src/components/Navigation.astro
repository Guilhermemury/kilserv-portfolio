---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<nav class="nav-container">
    <div class="logo">[ <a href="/" style="border:none" class="logo-text" data-text="Kilserv">Kilserv</a> ]</div>

    <ul class="desktop-menu">
        <li><a href="/" class={pathname === "/" ? "active" : ""}>home</a></li>
        <li><a href="/about" class={currentPath.startsWith("about") ? "active" : ""}>about</a></li>
        <li><a href="/research" class={currentPath.startsWith("research") || currentPath.startsWith("tags") ? "active" : ""}>research</a></li>
        <li><a href="/achievements" class={currentPath.startsWith("achievements") || currentPath.startsWith("cves") || currentPath.startsWith("certifications") || currentPath.startsWith("hall-of-fame") ? "active" : ""}>achievements</a></li>
        <li><a href="/contact" class={currentPath.startsWith("contact") ? "active" : ""}>contact</a></li>
    </ul>

    <details class="mobile-menu">
        <summary>$ menu</summary>
        <ul>
            <li>> <a href="/">home</a></li>
            <li>> <a href="/about">about</a></li>
            <li>> <a href="/research">research</a></li>
            <li>> <a href="/achievements">achievements</a></li>
            <li>> <a href="/contact">contact</a></li>
        </ul>
    </details>
</nav>

<style>
    .nav-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .logo {
        font-weight: bold;
    }
    .logo-text {
        position: relative;
        display: inline-block;
    }
    .logo-text:hover {
        animation: glitch 0.3s ease-in-out;
    }
    .logo-text:hover::before,
    .logo-text:hover::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }
    .logo-text:hover::before {
        color: #FF0055;
        animation: glitch-shift 0.3s ease-in-out;
        clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
    }
    .logo-text:hover::after {
        color: #00FFAA;
        animation: glitch-shift-rev 0.3s ease-in-out;
        clip-path: polygon(0 55%, 100% 55%, 100% 100%, 0 100%);
    }
    @keyframes glitch {
        0%, 100% { transform: translate(0); }
        20% { transform: translate(-2px, 1px); }
        40% { transform: translate(2px, -1px); }
        60% { transform: translate(-1px, -1px); }
        80% { transform: translate(1px, 1px); }
    }
    @keyframes glitch-shift {
        0%, 100% { transform: translate(0); }
        25% { transform: translate(2px, 0); }
        50% { transform: translate(-2px, 0); }
        75% { transform: translate(1px, 0); }
    }
    @keyframes glitch-shift-rev {
        0%, 100% { transform: translate(0); }
        25% { transform: translate(-2px, 0); }
        50% { transform: translate(2px, 0); }
        75% { transform: translate(-1px, 0); }
    }

    ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
    }

    .active::before {
        content: "> ";
    }

    .mobile-menu {
        display: none;
    }

    @media (max-width: 768px) {
        .desktop-menu { display: none; }
        .mobile-menu {
            display: block;
            cursor: pointer;
            position: relative;
        }
        .mobile-menu ul {
            flex-direction: column;
            position: absolute;
            background: var(--bg);
            border: 1px solid var(--border);
            padding: 1rem;
            right: 0;
            top: 100%;
            width: 200px;
            gap: 0.5rem;
            z-index: 10;
        }
    }
</style>
